# ============================================================
# FinBot — Dockerfile.backend
# FastAPI backend + RAG pipeline
# ============================================================

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (required for PyMuPDF + chroma_db download)
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY rag/ ./rag/
COPY data/ ./data/

# .env is intentionally NOT copied — environment variables are provided by
# the hosting platform (Render, etc.) at runtime. load_dotenv() in the app
# is a safe no-op when no .env file exists.

# Download and extract the ChromaDB vectorstore at build time.
# chroma_db/ is too large for git; provide the zip URL as a build ARG.
ARG CHROMA_DB_ZIP_URL
RUN if [ -z "$CHROMA_DB_ZIP_URL" ]; then \
      echo "ERROR: CHROMA_DB_ZIP_URL is not set." >&2; \
      echo "Pass it via: docker build --build-arg CHROMA_DB_ZIP_URL=<url>" >&2; \
      exit 1; \
    fi && \
    curl -L -o /tmp/chroma_db.zip "$CHROMA_DB_ZIP_URL" && \
    unzip /tmp/chroma_db.zip -d /app && \
    rm /tmp/chroma_db.zip

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
